  "sections": [
    {
      "_key": "section-1",
      "content": [
        {
          "_key": "block-2",
          "_type": "block",
          "children": [
            {
              "_key": "span-1",
              "_type": "span",
              "marks": [],
              "text": "You acknowledge and undertake that You are accessing the Classgrid Website (classgrid.in), its sub-domain tenant websites (*.classgrid.in), the Classgrid Mobile Application, and the Classgrid ERP Platform (collectively referred to as the \"Platform\") and its Services at Your own risk and are using Your best and prudent judgment before accessing, using, and/or entering into any communication through the Platform."
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "block-4",
          "_type": "block",
          "children": [
            {
              "_key": "span-3",
              "_type": "span",
              "marks": [],
              "text": "Classgrid Technologies (\"the Company\") shall neither be liable nor responsible for any actions or inactions of any User, including but not limited to institutional administrators, faculty members, students, parents, or visitors, nor for any breach of conditions, representations, or warranties by any User. The Company hereby expressly disclaims any and all responsibility and liability in that regard."
            }
          ],
          "markDefs": [],
          "style": "normal"
        }
      ],
      "id": "general-disclaimer",
      "title": "1. General Disclaimer"
    },
    {
      "_key": "section-2",
      "content": [
        {
          "_key": "block-2",
          "_type": "block",
          "children": [
            {
              "_key": "span-1",
              "_type": "span",
              "marks": [],
              "text": "The Platform enables educational institutions (\"Tenant Organizations\") to create and manage their own institutional websites and publish content including but not limited to notices, fee structures, academic calendars, faculty information, gallery media, blog posts, merit lists, and mandatory disclosures."
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "block-5",
          "_type": "block",
          "children": [
            {
              "_key": "span-3",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "All content published on tenant websites (slug.classgrid.in) is created, managed, and owned entirely by the respective Tenant Organization."
            },
            {
              "_key": "span-4",
              "_type": "span",
              "marks": [],
              "text": " The Company does not review, verify, endorse, or take responsibility for the accuracy, completeness, legality, or reliability of any content published by Tenant Organizations on their respective websites."
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "block-7",
          "_type": "block",
          "children": [
            {
              "_key": "span-6",
              "_type": "span",
              "marks": [],
              "text": "Any reliance that You place on any information provided on a tenant website is strictly at Your own risk."
            }
          ],
          "markDefs": [],
          "style": "normal"
        }
      ],
      "id": "institutional-content-disclaimer",
      "title": "2. Institutional Content Disclaimer"
    },
    {
      "_key": "section-3",
      "content": [
        {
          "_key": "block-2",
          "_type": "block",
          "children": [
            {
              "_key": "span-1",
              "_type": "span",
              "marks": [],
              "text": "The Platform serves as a management tool for educational institutions. All student records, academic data, examination results, attendance records, fee records, and other institutional data are entered and maintained by the respective Tenant Organization and its authorized personnel."
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "block-4",
          "_type": "block",
          "children": [
            {
              "_key": "span-3",
              "_type": "span",
              "marks": [],
              "text": "The Company does not independently verify the accuracy of any academic or student data. The Tenant Organization remains solely responsible for the correctness and integrity of all data entered into the Platform."
            }
          ],
          "markDefs": [],
          "style": "normal"
        }
      ],
      "id": "student-academic-data",
      "title": "3. Student & Academic Data"
    },
    {
      "_key": "section-4",
      "content": [
        {
          "_key": "block-2",
          "_type": "block",
          "children": [
            {
              "_key": "span-1",
              "_type": "span",
              "marks": [],
              "text": "Fee structures, scholarship details, installment plans, and any other financial information displayed on tenant websites or within the ERP Platform are provided by the respective Tenant Organization."
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "block-4",
          "_type": "block",
          "children": [
            {
              "_key": "span-3",
              "_type": "span",
              "marks": [],
              "text": "The Company is not a payment processor, financial institution, or intermediary. The Company shall not be liable for any disputes arising from fee-related information, payment processing, refund claims, or financial transactions between Users and Tenant Organizations."
            }
          ],
          "markDefs": [],
          "style": "normal"
        }
      ],
      "id": "fee-financial-information",
      "title": "4. Fee & Financial Information"
    },
    {
      "_key": "section-5",
      "content": [
        {
          "_key": "block-2",
          "_type": "block",
          "children": [
            {
              "_key": "span-1",
              "_type": "span",
              "marks": [],
              "text": "Certain features of the Platform may utilize artificial intelligence and machine learning technologies, including but not limited to past paper analysis, academic insights, and automated suggestions."
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "block-4",
          "_type": "block",
          "children": [
            {
              "_key": "span-3",
              "_type": "span",
              "marks": [],
              "text": "All AI-generated content, recommendations, and analysis are provided on an \"as-is\" and \"advisory only\" basis. The Company makes no warranties regarding the accuracy, completeness, or reliability of AI-generated outputs. Such outputs should not be treated as a substitute for professional academic judgment."
            }
          ],
          "markDefs": [],
          "style": "normal"
        }
      ],
      "id": "ai-powered-features",
      "title": "5. AI-Powered Features"
    },
    {
